# ---- Core ----
# Postgres. Neon: run `neon link` and it writes DATABASE_URL (+ _UNPOOLED) here.
# Self-host: postgres://awards:awards@localhost:5432/awards
DATABASE_URL=
AUTH_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000

# ---- Object storage ----
# Neon Object Storage: bucket is declared in neon.ts; `neon deploy` / `neon env
# pull` write AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_ENDPOINT_URL_S3 /
# AWS_REGION here. Set the bucket name to match neon.ts:
S3_BUCKET=attachments
#
# Self-hosted MinIO / other S3 instead — set these and leave AWS_* empty:
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# ---- Groq — supplementary AI assessment on the evaluate screen (optional) ----
# Leave GROQ_API_KEY blank to hide the "Run AI assessment" button entirely.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- Constrained hosts (e.g. Vercel: 4.5 MB serverless request-body cap) ----
# The demo video is a link (OneDrive etc.), not an upload — only supporting
# files post through the server action.
# NEXT_PUBLIC_MAX_FILE_MB=3
# NEXT_PUBLIC_MAX_FILES=3
# SERVER_ACTION_BODY_LIMIT=4mb
# DB_POOL_MAX=1            # or use a pooled DATABASE_URL (Neon -pooler host)
