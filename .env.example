# ---- Core ----
DATABASE_URL=postgres://awards:awards@localhost:5432/awards
AUTH_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000

# ---- Object storage (MinIO / any S3-compatible bucket on your infra) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=awards-attachments
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---- Claude (advisory only: intake summary + consensus draft. NEVER scoring) ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# "1" disables all AI calls AND the job queue (portal works fully without them)
AI_DISABLED=0

# ---- Constrained hosts (e.g. Vercel: 4.5 MB serverless request-body cap) ----
# NEXT_PUBLIC_MAX_VIDEO_MB=4
# NEXT_PUBLIC_MAX_FILE_MB=3
# NEXT_PUBLIC_MAX_FILES=3
# SERVER_ACTION_BODY_LIMIT=4mb
# DB_POOL_MAX=1            # or use a pooled DATABASE_URL (Neon -pooler host)
